{
  "youtube_concurrent": 3,
  "instagram_concurrent": 6,
  "pipeline": {
    "queue_capacity": 16,
    "instagram": {"window_seconds": 60, "max_requests": 20, "min_interval_seconds": 6, "cooldown_seconds": 62},
    "youtube": {"window_seconds": 60, "max_requests": 20, "min_interval_seconds": 6, "cooldown_seconds": 62},
    "instagram_source_cache_ttl_minutes": 60,
    "instagram_source_cache_capacity": 64
  },
  "sleep": {
    "instagram": {"enabled": false, "start": "00:00", "end": "06:00", "timezone": "Asia/Singapore"},
    "youtube": {"enabled": false, "start": "00:00", "end": "06:00", "timezone": "Asia/Singapore"}
  },
  "template": "{platform}/{directory_name}/{year}/{month}{day}/{filename}",
  "auto_archive": false,
  "youtube": {
    "video": true,
    "format": "bestvideo+bestaudio/best",
    "subtitles": true,
    "auto_subtitles": true,
    "subtitle_languages": "zh.*,en",
    "comments": true,
    "extra_audio": true,
    "extract_audio": false,
    "audio_format": "m4a",
    "audio_quality": "0",
    "thumbnail": true,
    "metadata": true,
    "fragments": 6
  },
  "use_upload_date": true,
  "ui": {
    "recent_downloads": 3,
    "history_page_size": 20,
    "task_page_size": 20,
    "task_log_lines": 100,
    "language": "zh-CN"
  },
  "debug": {
    "test_item_limit": 0
  }
}
